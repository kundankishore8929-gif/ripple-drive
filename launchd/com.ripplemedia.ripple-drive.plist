<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>com.ripplemedia.ripple-drive</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>__HOME__/.local/bin/ripple-drive-mount</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/RippleDrive/launchd.log</string>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/RippleDrive/launchd.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
